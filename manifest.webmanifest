{
  "name": "Clipper Fuel Planner",
  "short_name": "Fuel Planner",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#08001f",
  "theme_color": "#08001f",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png"}
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {"files": [{"name": "itinerary", "accept": ["application/pdf", ".pdf"]}]}
  }
}
